const STORAGE_KEY = 'talabek-phone-store-v1';

const defaultProducts = [
  { id: 1, name: 'أيفون 15 برو', category: 'phones', price: 4250, stock: 8, description: 'بنية فاخرة، شاشة OLED، كاميرا قوية', emoji: '📱' },
  { id: 2, name: 'سامسونج S24', category: 'phones', price: 3900, stock: 12, description: 'أداء ممتاز مع كاميرا احترافية', emoji: '📲' },
  { id: 3, name: 'شاومي Redmi Note 13', category: 'phones', price: 2600, stock: 18, description: 'سعر مناسب وأداء ممتاز في فئة متوسطة', emoji: '📱' },
  { id: 4, name: 'سماعات رأس Bluetooth', category: 'accessories', price: 550, stock: 30, description: 'صوت واضح وراحة عالية خلال اليوم', emoji: '🎧' },
  { id: 5, name: 'كابل شحن USB-C', category: 'accessories', price: 180, stock: 44, description: 'كابل مقاوم ومناسب للشحن السريع', emoji: '🔌' },
  { id: 6, name: 'غطاء حماية زجاجي', category: 'accessories', price: 240, stock: 25, description: 'حماية كاملة للشاشة مع لمسة دقيقة', emoji: '🛡️' },
  { id: 7, name: 'عرض خاص: ساعتي ذكية', category: 'offers', price: 1300, stock: 9, description: 'عروض محدودة لمدة أسبوع', emoji: '⌚' },
  { id: 8, name: 'بطارية Power Bank', category: 'offers', price: 980, stock: 13, description: 'بطارية سريعة الشحن بقدرة عالية', emoji: '🔋' }
];

const state = {
  products: loadProducts(),
  cart: loadCart(),
  orders: loadOrders(),
  selectedCategory: 'all',
  searchText: '',
  editingProductId: null,
  installPrompt: null
};

const productList = document.getElementById('productList');
const cartItems = document.getElementById('cartItems');
const cartTotal = document.getElementById('cartTotal');
const cartCount = document.getElementById('cartCount');
const cartDrawer = document.getElementById('cartDrawer');
const orderSection = document.getElementById('orderSection');
const orderForm = document.getElementById('orderForm');
const searchInput = document.getElementById('searchInput');
const adminProducts = document.getElementById('adminProducts');
const ordersList = document.getElementById('ordersList');
const toast = document.getElementById('toast');
const installBtn = document.getElementById('installBtn');

function loadProducts() {
  const saved = localStorage.getItem(`${STORAGE_KEY}:products`);
  return saved ? JSON.parse(saved) : defaultProducts;
}

function loadCart() {
  const saved = localStorage.getItem(`${STORAGE_KEY}:cart`);
  return saved ? JSON.parse(saved) : [];
}

function loadOrders() {
  const saved = localStorage.getItem(`${STORAGE_KEY}:orders`);
  return saved ? JSON.parse(saved) : [];
}

function saveState() {
  localStorage.setItem(`${STORAGE_KEY}:products`, JSON.stringify(state.products));
  localStorage.setItem(`${STORAGE_KEY}:cart`, JSON.stringify(state.cart));
  localStorage.setItem(`${STORAGE_KEY}:orders`, JSON.stringify(state.orders));
}

function formatCurrency(value) {
  return new Intl.NumberFormat('ar-MA', {
    style: 'currency',
    currency: 'MRO',
    maximumFractionDigits: 0
  }).format(value);
}

function showToast(message) {
  toast.textContent = message;
  toast.classList.add('show');
  clearTimeout(showToast.timeout);
  showToast.timeout = setTimeout(() => toast.classList.remove('show'), 2200);
}

function getVisibleProducts() {
  return state.products.filter((product) => {
    const categoryMatch = state.selectedCategory === 'all' || product.category === state.selectedCategory || (state.selectedCategory === 'offers' && product.category === 'offers');
    const text = `${product.name} ${product.description}`.toLowerCase();
    const searchMatch = text.includes(state.searchText.toLowerCase());
    return categoryMatch && searchMatch;
  });
}

function renderProducts() {
  const visibleProducts = getVisibleProducts();

  if (visibleProducts.length === 0) {
    productList.innerHTML = '<div class="cart-empty">لا توجد منتجات تطابق البحث الحالي.</div>';
    return;
  }

  productList.innerHTML = visibleProducts.map((product) => `
    <article class="product-card">
      <div class="product-image">${product.emoji}</div>
      <div class="product-body">
        <span class="product-tag">${product.category === 'phones' ? 'هاتف' : product.category === 'offers' ? 'عرض' : 'ملحق'}</span>
        <h4>${product.name}</h4>
        <p>${product.description}</p>
        <div class="product-meta">
          <span class="price">${formatCurrency(product.price)}</span>
          <span class="stock">المخزون: ${product.stock}</span>
        </div>
        <div class="product-actions">
          <button type="button" class="add-btn" data-add-product="${product.id}">أضف للسلة</button>
        </div>
      </div>
    </article>
  `).join('');

  document.querySelectorAll('[data-add-product]').forEach((button) => {
    button.addEventListener('click', () => addToCart(Number(button.dataset.addProduct)));
  });
}

function renderCart() {
  cartCount.textContent = state.cart.reduce((sum, item) => sum + item.quantity, 0);

  if (state.cart.length === 0) {
    cartItems.innerHTML = '<div class="cart-empty">السلة فارغة الآن.</div>';
    cartTotal.textContent = formatCurrency(0);
    document.getElementById('orderItemCount').textContent = '0';
    document.getElementById('orderTotalValue').textContent = formatCurrency(0);
    return;
  }

  const total = state.cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
  cartItems.innerHTML = state.cart.map((item) => `
    <div class="cart-item">
      <div class="cart-thumb">${item.emoji}</div>
      <div>
        <h4>${item.name}</h4>
        <div class="item-controls">
          <button class="qty-btn" type="button" data-qty="-" data-id="${item.id}">-</button>
          <span>${item.quantity}</span>
          <button class="qty-btn" type="button" data-qty="+" data-id="${item.id}">+</button>
        </div>
      </div>
      <strong>${formatCurrency(item.price * item.quantity)}</strong>
    </div>
  `).join('');

  cartTotal.textContent = formatCurrency(total);
  document.getElementById('orderItemCount').textContent = state.cart.reduce((sum, item) => sum + item.quantity, 0);
  document.getElementById('orderTotalValue').textContent = formatCurrency(total);

  document.querySelectorAll('[data-qty]').forEach((button) => {
    button.addEventListener('click', () => updateCartQuantity(Number(button.dataset.id), button.dataset.qty === '+' ? 1 : -1));
  });
}

function addToCart(productId) {
  const product = state.products.find((item) => item.id === productId);
  if (!product) return;

  const existing = state.cart.find((item) => item.id === productId);
  if (existing) {
    if (existing.quantity >= product.stock) {
      showToast('الكمية المطلوبة تتجاوز المخزون المتوفر');
      return;
    }
    existing.quantity += 1;
  } else {
    state.cart.push({ ...product, quantity: 1 });
  }

  saveState();
  renderCart();
  showToast('تمت إضافة المنتج إلى السلة');
}

function updateCartQuantity(productId, delta) {
  const item = state.cart.find((entry) => entry.id === productId);
  if (!item) return;

  item.quantity += delta;
  if (item.quantity <= 0) {
    state.cart = state.cart.filter((entry) => entry.id !== productId);
  }

  saveState();
  renderCart();
}

function toggleCart(open) {
  cartDrawer.classList.toggle('open', open);
}

function handleOrderSubmit(event) {
  event.preventDefault();

  if (state.cart.length === 0) {
    showToast('السلة فارغة، أضف منتجات قبل إتمام الطلب');
    return;
  }

  const formData = new FormData(orderForm);
  const order = {
    id: Date.now(),
    customerName: formData.get('customerName'),
    customerPhone: formData.get('customerPhone'),
    city: formData.get('city'),
    address: formData.get('address'),
    createdAt: new Date().toLocaleString('ar-EG'),
    total: state.cart.reduce((sum, item) => sum + item.quantity * item.price, 0),
    items: state.cart.map((item) => ({
      name: item.name,
      quantity: item.quantity,
      price: item.price,
      total: item.quantity * item.price
    }))
  };

  state.orders.unshift(order);
  state.cart = [];
  saveState();
  renderCart();
  renderOrders();
  orderForm.reset();
  orderSection.classList.add('hidden');
  showToast('تم تسجيل الطلب بنجاح');
}

function renderOrders() {
  if (state.orders.length === 0) {
    ordersList.innerHTML = '<div class="cart-empty">لا توجد طلبات حتى الآن.</div>';
    return;
  }

  ordersList.innerHTML = state.orders.map((order) => `
    <div class="order-item">
      <div class="order-content">
        <strong>${order.customerName}</strong>
        <small>${order.customerPhone} • ${order.city}</small>
        <small>${order.items.map((item) => `${item.name} × ${item.quantity}`).join(' • ')}</small>
      </div>
      <div>
        <strong>${formatCurrency(order.total)}</strong>
        <small>${order.createdAt}</small>
      </div>
      <span class="order-status">تم التأكيد</span>
    </div>
  `).join('');
}

function renderAdminProducts() {
  adminProducts.innerHTML = state.products.map((product) => `
    <div class="admin-item">
      <div>
        <strong>${product.name}</strong>
        <small>${formatCurrency(product.price)} • ${product.stock} متوفر</small>
      </div>
      <div class="admin-actions">
        <button type="button" class="edit-btn" data-edit-product="${product.id}">تعديل</button>
        <button type="button" class="delete-btn" data-delete-product="${product.id}">حذف</button>
      </div>
    </div>
  `).join('');

  document.querySelectorAll('[data-edit-product]').forEach((button) => {
    button.addEventListener('click', () => startEditProduct(Number(button.dataset.editProduct)));
  });

  document.querySelectorAll('[data-delete-product]').forEach((button) => {
    button.addEventListener('click', () => deleteProduct(Number(button.dataset.deleteProduct)));
  });
}

function handleProductSubmit(event) {
  event.preventDefault();

  const name = document.getElementById('productName').value.trim();
  const category = document.getElementById('productCategory').value;
  const price = Number(document.getElementById('productPrice').value);
  const stock = Number(document.getElementById('productStock').value);
  const description = document.getElementById('productDescription').value.trim();

  if (!name || !description || !Number.isFinite(price) || !Number.isFinite(stock)) {
    showToast('يرجى إدخال بيانات المنتج كاملة');
    return;
  }

  if (state.editingProductId) {
    const product = state.products.find((item) => item.id === state.editingProductId);
    if (product) {
      product.name = name;
      product.category = category;
      product.price = price;
      product.stock = stock;
      product.description = description;
      showToast('تم تعديل المنتج بنجاح');
    }
  } else {
    const product = {
      id: Date.now(),
      name,
      category,
      price,
      stock,
      description,
      emoji: category === 'phones' ? '📱' : '🔧'
    };
    state.products.unshift(product);
    showToast('تمت إضافة المنتج بنجاح');
  }

  saveState();
  resetProductForm();
  renderProducts();
  renderAdminProducts();
}

function startEditProduct(productId) {
  const product = state.products.find((item) => item.id === productId);
  if (!product) return;

  state.editingProductId = productId;
  document.getElementById('productFormTitle').textContent = 'تعديل المنتج';
  document.getElementById('productId').value = String(productId);
  document.getElementById('productName').value = product.name;
  document.getElementById('productCategory').value = product.category;
  document.getElementById('productPrice').value = product.price;
  document.getElementById('productStock').value = product.stock;
  document.getElementById('productDescription').value = product.description;
  document.getElementById('cancelEdit').classList.remove('hidden');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function resetProductForm() {
  state.editingProductId = null;
  document.getElementById('productFormTitle').textContent = 'إضافة منتج جديد';
  document.getElementById('productForm').reset();
  document.getElementById('cancelEdit').classList.add('hidden');
}

function deleteProduct(productId) {
  const product = state.products.find((item) => item.id === productId);
  if (!product) return;

  state.products = state.products.filter((item) => item.id !== productId);
  state.cart = state.cart.filter((item) => item.id !== productId);
  saveState();
  renderProducts();
  renderCart();
  renderAdminProducts();
  showToast(`تم حذف ${product.name}`);
}

function bindNavigation() {
  document.querySelectorAll('.nav-link').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.nav-link').forEach((link) => link.classList.remove('active'));
      button.classList.add('active');
      const filter = button.dataset.filter;
      state.selectedCategory = filter === 'offers' ? 'offers' : filter;
      renderProducts();
    });
  });

  document.querySelectorAll('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.chip').forEach((item) => item.classList.remove('active'));
      chip.classList.add('active');
      state.selectedCategory = chip.dataset.category;
      renderProducts();
    });
  });

  searchInput.addEventListener('input', (event) => {
    state.searchText = event.target.value;
    renderProducts();
  });

  document.getElementById('cartToggle').addEventListener('click', () => toggleCart(true));
  document.getElementById('closeCart').addEventListener('click', () => toggleCart(false));
  document.getElementById('checkoutBtn').addEventListener('click', () => {
    toggleCart(false);
    orderSection.classList.remove('hidden');
  });
  document.getElementById('closeOrderForm').addEventListener('click', () => orderSection.classList.add('hidden'));
  orderForm.addEventListener('submit', handleOrderSubmit);
  document.getElementById('productForm').addEventListener('submit', handleProductSubmit);
  document.getElementById('cancelEdit').addEventListener('click', resetProductForm);

  document.addEventListener('click', (event) => {
    if (event.target === orderSection || event.target === cartDrawer) {
      orderSection.classList.add('hidden');
      cartDrawer.classList.remove('open');
    }
  });
}

function registerServiceWorker() {
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./service-worker.js').catch((error) => {
        console.error('Service worker registration failed:', error);
      });
    });
  }
}

function setupInstallPrompt() {
  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    state.installPrompt = event;
    installBtn.classList.remove('hidden');
  });

  installBtn.addEventListener('click', async () => {
    if (!state.installPrompt) {
      showToast('يجب فتح التطبيق في متصفح يدعم التثبيت');
      return;
    }

    state.installPrompt.prompt();
    const result = await state.installPrompt.userChoice;
    if (result.outcome === 'accepted') {
      showToast('تم تثبيت التطبيق بنجاح');
    }
    state.installPrompt = null;
    installBtn.classList.add('hidden');
  });
}

function init() {
  bindNavigation();
  renderProducts();
  renderCart();
  renderAdminProducts();
  renderOrders();
  registerServiceWorker();
  setupInstallPrompt();
}

init();
